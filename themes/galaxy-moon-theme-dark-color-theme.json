  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#B97995",
    "interface": "#B97995",
    "enum": "#B97995",
    "type": "#B97995",
    "function": "#6DA2A8",
    "method": "#6DA2A8",
    "parameter": "#F1E9F1",
    "property": "#F1E9F1",
    "variable": "#F1E9F1"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#9A959A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#9AA458"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#A8833B"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B97995"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6DA2A8"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#F1E9F1"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#A8833B"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#D26B74"
      }
    }
  ]
}
