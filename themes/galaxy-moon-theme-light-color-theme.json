    "terminal.ansiYellow": "#83662E",
    "terminal.ansiBlue": "#6C849F",
    "terminal.ansiMagenta": "#A66C86",
    "terminal.ansiCyan": "#619197",
    "terminal.ansiWhite": "#595959",
    "terminal.ansiBrightBlack": "#595959",
    "terminal.ansiBrightRed": "#C23B46",
    "terminal.ansiBrightGreen": "#8A9752",
    "terminal.ansiBrightYellow": "#83662E",
    "terminal.ansiBrightBlue": "#6C849F",
    "terminal.ansiBrightMagenta": "#A66C86",
    "terminal.ansiBrightCyan": "#619197",
    "terminal.ansiBrightWhite": "#232323"
