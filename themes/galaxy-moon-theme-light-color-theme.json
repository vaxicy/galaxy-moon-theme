  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#AC6C88",
    "interface": "#AC6C88",
    "enum": "#AC6C88",
    "type": "#AC6C88",
    "function": "#60959B",
    "method": "#60959B",
    "parameter": "#232323",
    "property": "#232323",
    "variable": "#232323"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#595959",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#6C6C6C"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#8A9752"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#83662E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#AC6C88"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#60959B"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#232323"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#6C6C6C"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#83662E"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#6C6C6C"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#C23B46"
      }
    }
  ]
}
